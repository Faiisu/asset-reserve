# ==============================================================================
# Real deploy -- frontend (deploy/prod/frontend/docker-compose.yml)
#
# Copy to deploy/prod/frontend/.env. Requires deploy/prod/backend's stack to
# already be up (its `asset-reservation-network` is joined here as external).
# ==============================================================================

FRONTEND_HOST_PORT=8080

# Must match the network name deploy/prod/database's stack created.
DOCKER_NETWORK_NAME=asset-reservation-network
