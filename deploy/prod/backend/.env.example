# ==============================================================================
# Real deploy -- backend (deploy/prod/backend/docker-compose.yml)
#
# Copy to deploy/prod/backend/.env. Requires deploy/prod/database's stack to
# already be up (its `asset-reservation-network` is joined here as external).
# ==============================================================================

# Must match deploy/prod/database/.env exactly (same Postgres credentials).
DOCKER_DATABASE_URL=postgresql://asset_reservation:change-this-database-password@postgres:5432/asset_reservation?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Required. Direct Swagger/API access port; production can omit the host
# port mapping in docker-compose.yml and expose only the frontend's Nginx.
BACKEND_HOST_PORT=3000

# Required -- generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=https://your-domain.example
TRUST_PROXY=true
RECOGNITION_SERVICE_URL=http://recognition-service:8000

# Initial administrator bootstrap (first deploy only; username: admin).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=00000000
BOOTSTRAP_ADMIN_NAME=System Admin
# Real deploys don't load demo data. Only flip to true if this environment
# intentionally wants the mock dataset.
LOAD_MOCK_DATA=false
MOCK_USER_PASSWORD=

# Email (Gmail SMTP + App Password) -- optional, leave SMTP_USER/
# SMTP_APP_PASSWORD blank to disable notification emails. Set both or neither.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Advantech Asset Reservation

# Secret encryption -- only required once an admin saves an App Password
# through Administration > Notification. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Sign-In & account linking -- optional, leave all three blank to
# disable. See docs/oauth-setup.md for the Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft/Outlook Sign-In & account linking -- optional, independently
# configurable from GOOGLE_* above.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT_ID=

FRONTEND_BASE_URL=https://your-domain.example
REQUIRE_ACCOUNT_LINK=

UPLOADS_VOLUME_NAME=asset-reservation-uploads-data

# Must match the network name deploy/prod/database's stack created.
DOCKER_NETWORK_NAME=asset-reservation-network
