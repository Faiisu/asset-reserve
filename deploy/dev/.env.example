# ==============================================================================
# Dev deploy configuration (deploy/dev/docker-compose.yml)
#
# Rebuilds every image from the current source tree on every deploy. Copy to
# deploy/dev/.env and adjust as needed -- defaults below already work.
# ==============================================================================

# Database (PostgreSQL 17)
POSTGRES_DB=asset_reservation_dev
POSTGRES_USER=asset_reservation
POSTGRES_PASSWORD=dev-password
POSTGRES_PORT=15432
POSTGRES_VOLUME_NAME=asset-reservation-dev-postgres-data

# Backend API (NestJS + Fastify)
BACKEND_PORT=13000
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
JWT_SECRET=dev-jwt-secret-key-must-be-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:18080,http://localhost:13000,http://127.0.0.1:18080,http://127.0.0.1:13000
TRUST_PROXY=true
RECOGNITION_SERVICE_URL=http://host.docker.internal:8000
UPLOADS_VOLUME_NAME=asset-reservation-dev-uploads-data

# Email (Gmail SMTP + App Password) -- optional, leave SMTP_USER/
# SMTP_APP_PASSWORD blank to disable notification emails. Set both or neither.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Advantech Asset Reservation

# Secret encryption -- only required once an admin saves an App Password
# through Administration > Notification. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Sign-In & account linking -- optional, leave all three blank to
# disable. See docs/oauth-setup.md for the Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:13000/api/v1/auth/google/callback

# Microsoft/Outlook Sign-In & account linking -- optional, independently
# configurable from GOOGLE_* above.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:13000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=

FRONTEND_BASE_URL=http://localhost:18080
# Off by default in dev so login isn't blocked by the account-link gate.
REQUIRE_ACCOUNT_LINK=false

# Initial Administrator Bootstrap & Seed Data
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=00000000
BOOTSTRAP_ADMIN_NAME=System Admin
LOAD_MOCK_DATA=true
MOCK_USER_PASSWORD=password123456

# Frontend (React 19 + Nginx)
FRONTEND_PORT=18080

# Docker Network
DOCKER_NETWORK_NAME=asset-reservation-dev-network
