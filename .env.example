# ==============================================================================
# Unified Docker Deployment Configuration
# ==============================================================================

# Database (PostgreSQL 17)
POSTGRES_DB=asset_reservation
POSTGRES_USER=asset_reservation
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHM_SIZE=256mb
POSTGRES_VOLUME_NAME=asset-reservation-postgres-data

# Backend API (NestJS + Fastify)
BACKEND_PORT=3000
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters-for-production
JWT_ACCESS_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:3000
TRUST_PROXY=true
UPLOADS_VOLUME_NAME=asset-reservation-uploads-data

# Email (Gmail SMTP + App Password) -- optional, leave SMTP_USER/
# SMTP_APP_PASSWORD blank to disable notification emails. Set both or neither.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Advantech Asset Reservation

# Secret encryption -- only required once an admin saves an App Password
# through Administration > Notification. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Sign-In & account linking -- optional, leave all three blank to
# disable. See docs/oauth-setup.md for the Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Microsoft/Outlook Sign-In & account linking -- optional, independently
# configurable from GOOGLE_* above. See docs/oauth-setup.md for the Azure
# App Registration setup and what MICROSOFT_TENANT_ID controls (defaults
# to "common" -- both personal and work/school accounts -- if unset).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=

FRONTEND_BASE_URL=http://localhost:8080
# Whether every user must link Google or Microsoft (either satisfies it)
# before using the app. Defaults to on once a provider is configured --
# set to "false" for local development so login isn't blocked by the
# link gate.
REQUIRE_ACCOUNT_LINK=

# Initial Administrator Bootstrap & Seed Data
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=00000000
BOOTSTRAP_ADMIN_NAME=System Admin
LOAD_MOCK_DATA=true
MOCK_USER_PASSWORD=password123456

# Frontend (React 19 + Nginx)
FRONTEND_PORT=8080

# Docker Network
DOCKER_NETWORK_NAME=asset-reservation-network
