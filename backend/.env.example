# Application Port
PORT=3000

# Database Connection (Local Development pointing to Docker Compose Postgres)
DATABASE_URL=postgresql://asset_reservation:change-this-database-password@localhost:5432/asset_reservation?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Authentication & Security
JWT_SECRET=dev-jwt-secret-key-must-be-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=true

# Initial Admin Bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=00000000
BOOTSTRAP_ADMIN_NAME=System Admin

# Mock Seed Data
LOAD_MOCK_DATA=true
MOCK_USER_PASSWORD=password123
