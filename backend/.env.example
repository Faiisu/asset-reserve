NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://asset_reservation:change-me@localhost:5432/asset_reservation
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
OPENAPI_CONTRACT_PATH=../docs/backend_spec/contracts/auth-permission.openapi.yaml

# Used only by `npm run seed`
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-initial-password
BOOTSTRAP_ADMIN_NAME=System Admin
