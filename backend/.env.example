# Application Port
PORT=3000

# Database Connection (Local Development pointing to Docker Compose Postgres)
DATABASE_URL=postgresql://asset_reservation:change-this-database-password@localhost:5432/asset_reservation?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Authentication & Security
JWT_SECRET=dev-jwt-secret-key-must-be-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=true

# Initial Admin Bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=00000000
BOOTSTRAP_ADMIN_NAME=System Admin

# Mock Seed Data
LOAD_MOCK_DATA=true
MOCK_USER_PASSWORD=password123456

# Email (Gmail SMTP + App Password via Nodemailer) -- optional. Leave
# SMTP_USER/SMTP_APP_PASSWORD blank (or unset) to disable email entirely;
# the app boots fine either way. If you set one, set both -- a partial
# pair throws at startup rather than silently sending from a broken config.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Advantech Asset Reservation

# Secret encryption -- only required once an admin saves an App Password
# through Administration > Notification (the settings page stores it
# encrypted in the database instead of only in SMTP_APP_PASSWORD above).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Sign-In & account linking -- optional. Leave all three blank (or
# unset) to disable entirely; the app boots fine either way and admin-
# created users just never see a "link Google" prompt. If you set one,
# set all three. See docs/oauth-setup.md for the Google Cloud Console
# setup checklist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Microsoft/Outlook Sign-In & account linking -- optional, same
# all-or-nothing shape as GOOGLE_* above (independently configurable --
# offer either, both, or neither). MICROSOFT_TENANT_ID controls which
# Microsoft accounts may sign in and defaults to "common" (both personal
# Outlook/Hotmail accounts and work/school Azure AD accounts) if unset --
# see docs/oauth-setup.md for the Azure App Registration checklist and
# what the other tenant values mean.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=

# Only needed once GOOGLE_*/MICROSOFT_* above is set -- used to build the
# redirect back to the SPA at the end of an OAuth flow.
FRONTEND_BASE_URL=http://localhost:5173
# Whether every user must link an external account (Google or Microsoft --
# either satisfies it) before using the app. Only has any effect when at
# least one provider above is configured (nothing to force-link to
# otherwise). Defaults to on once a provider is configured -- set to
# "false" for local development against real OAuth credentials without
# every login being blocked by the link gate.
REQUIRE_ACCOUNT_LINK=
