{
  "name": "asset-reservation-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "openapi:bundle": "node scripts/bundle-openapi.mjs",
    "prebuild": "npm run openapi:bundle",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "predev": "npm run openapi:bundle",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:node": "node --watch dist/src/main.js",
    "dev": "prisma generate && concurrently -k -p \"[{name}]\" -n \"TSC,NODE\" -c \"blue.bold,green.bold\" \"npm:dev:tsc\" \"npm:dev:node\"",
    "start": "node dist/src/main.js",
    "test": "vitest run --dir test",
    "test:watch": "vitest --dir test",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.ts\" \"*.{json,md}\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma generate && tsx scripts/reset-and-seed-admin-only.ts",
    "db:seed": "prisma generate && tsx scripts/seed.ts",
    "seed": "prisma generate && tsx scripts/seed.ts",
    "reset:admin": "prisma generate && tsx scripts/reset-and-seed-admin-only.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.0",
    "@nestjs/core": "11.2.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.0",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "google-auth-library": "^11.0.2",
    "nodemailer": "^9.0.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.21.0",
    "concurrently": "^10.0.5",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "5.3.0"
  }
}
