DATABASE_URL=postgresql://asset_reservation:change-this-database-password@postgres:5432/asset_reservation?schema=public
DOCKER_DATABASE_URL=postgresql://asset_reservation:change-this-database-password@postgres:5432/asset_reservation?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
BACKEND_HOST_PORT=3000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=true

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=00000000
BOOTSTRAP_ADMIN_NAME=System Admin

# Set false when deploying without demonstration records.
LOAD_MOCK_DATA=true
MOCK_USER_PASSWORD=replace-with-a-long-mock-password
DOCKER_NETWORK_NAME=asset-reservation-network

# Internal-only asset recognition service (recognition-service/). Never
# exposed outside the docker network -- only this backend talks to it.
RECOGNITION_SERVICE_URL=http://recognition-service:8000

# Email (Gmail SMTP + App Password via Nodemailer) -- optional, leave
# SMTP_USER/SMTP_APP_PASSWORD blank to disable. Set both or neither.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Advantech Asset Reservation

# Secret encryption -- only required once an admin saves an App Password
# through Administration > Notification. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Sign-In & account linking -- optional, leave all three blank to
# disable. See docs/google-integrations-plan.md for the Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_BASE_URL=http://localhost:8080
# Defaults to on once Google is configured -- set to "false" for local
# development so login isn't blocked by the link gate.
REQUIRE_GOOGLE_LINK=
