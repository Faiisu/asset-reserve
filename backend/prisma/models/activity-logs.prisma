model ActivityLog {
  id            String   @id @db.Uuid
  reservationId String?  @map("reservation_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  action        String   @db.VarChar(60)
  entityType    String   @map("entity_type") @db.VarChar(40)
  entityId      String?  @map("entity_id") @db.Uuid
  details       Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor       User         @relation("UserActivityLogs", fields: [actorId], references: [id])
  reservation Reservation? @relation("ReservationActivityLogs", fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}
