model Return {
  id            String    @id @db.Uuid
  reservationId String    @map("reservation_id") @db.Uuid
  returnedBy    String    @map("returned_by") @db.Uuid
  /// Supported values: PENDING, REJECTED, COMPLETED. Approval decisions live on ReturnApproval.
  status        String    @default("PENDING") @db.VarChar(20)
  note          String?
  returnedAt    DateTime? @map("returned_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  reservation      Reservation       @relation(fields: [reservationId], references: [id])
  returner         User              @relation("ReturnReturnedBy", fields: [returnedBy], references: [id])
  items            ReturnItem[]
  approval         ReturnApproval?
  reputationEvents ReputationEvent[]

  @@index([reservationId])
  @@index([status])
  @@index([returnedBy])
  @@map("returns")
}

model ReturnItem {
  id                String  @id @db.Uuid
  returnId          String  @map("return_id") @db.Uuid
  reservationItemId String  @map("reservation_item_id") @db.Uuid
  description       String?
  pictureUrl        String? @map("picture_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  return          Return           @relation(fields: [returnId], references: [id])
  reservationItem ReservationItem  @relation(fields: [reservationItemId], references: [id])
  units           ReturnItemUnit[]

  @@unique([returnId, reservationItemId])
  @@index([reservationItemId])
  @@map("return_items")
}

model ReturnItemUnit {
  id                    String  @id @db.Uuid
  returnItemId          String  @map("return_item_id") @db.Uuid
  reservationItemUnitId String  @unique @map("reservation_item_unit_id") @db.Uuid
  /// Supported values: GOOD, BROKEN, LOST. Null until the return is inspected and decided --
  /// set at that point, not at drop-off submission.
  condition             String? @db.VarChar(10)
  pictureUrl            String? @map("picture_url")
  note                  String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  returnItem          ReturnItem          @relation(fields: [returnItemId], references: [id])
  reservationItemUnit ReservationItemUnit @relation(fields: [reservationItemUnitId], references: [id])

  @@index([returnItemId])
  @@map("return_item_units")
}

model ReturnApproval {
  id          String    @id @db.Uuid
  returnId    String    @unique @map("return_id") @db.Uuid
  approverId  String    @map("approver_id") @db.Uuid
  /// Supported values: PENDING, APPROVED, REJECTED.
  status      String    @default("PENDING") @db.VarChar(20)
  description String?
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  return   Return @relation(fields: [returnId], references: [id])
  approver User   @relation(fields: [approverId], references: [id])

  @@index([approverId])
  @@map("return_approvals")
}
