model Asset {
  id               String  @id @db.Uuid
  managementAreaId String  @map("management_area_id") @db.Uuid
  createdById      String? @map("created_by") @db.Uuid
  name             String  @db.VarChar(150)
  partNumber       String? @map("part_number") @db.VarChar(100)
  description      String?
  pictureUrl       String? @map("picture_url")
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  managementArea   ManagementArea    @relation(fields: [managementAreaId], references: [id])
  createdBy        User?             @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  units            AssetUnit[]
  reservationItems ReservationItem[]

  // Database UNIQUE required by the source specification: (management_area_id, part_number) where part_number is not null.
  @@unique([managementAreaId, name])
  @@index([createdById])
  @@index([managementAreaId, isActive])
  @@map("assets")
}

model AssetUnit {
  id           String  @id @db.Uuid
  assetId      String  @map("asset_id") @db.Uuid
  serialNumber String  @map("serial_number") @db.VarChar(100)
  /// Supported values: ACTIVE, RESERVED, CHECKED_OUT, BROKEN, LOST, IN_REPAIR, INACTIVE.
  status       String  @default("ACTIVE") @db.VarChar(20)
  note         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  asset                Asset                 @relation(fields: [assetId], references: [id])
  reservationItemUnits ReservationItemUnit[]
  events               AssetUnitEvent[]

  @@unique([serialNumber])
  @@index([assetId, status])
  @@map("asset_units")
}

model AssetUnitEventBatch {
  id          String  @id @db.Uuid
  description String?
  performedBy String  @map("performed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  performer User             @relation(fields: [performedBy], references: [id])
  events    AssetUnitEvent[]

  @@index([performedBy])
  @@map("asset_unit_event_batches")
}

model AssetUnitEvent {
  id                String  @id @db.Uuid
  batchId           String  @map("batch_id") @db.Uuid
  assetUnitId       String  @map("asset_unit_id") @db.Uuid
  /// Supported values: REGISTERED, RETIRED, REACTIVATED, RESERVED, CHECKED_OUT,
  /// RETURNED_GOOD, RETURNED_BROKEN, RETURNED_LOST, REPAIRED, ADJUSTMENT.
  eventType         String  @map("event_type") @db.VarChar(30)
  fromStatus        String? @map("from_status") @db.VarChar(20)
  toStatus          String? @map("to_status") @db.VarChar(20)
  reservationItemId String? @map("reservation_item_id") @db.Uuid
  reason            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch           AssetUnitEventBatch @relation(fields: [batchId], references: [id])
  assetUnit       AssetUnit           @relation(fields: [assetUnitId], references: [id])
  reservationItem ReservationItem?    @relation(fields: [reservationItemId], references: [id])

  @@index([assetUnitId, createdAt])
  @@index([batchId])
  @@index([reservationItemId])
  @@map("asset_unit_events")
}
