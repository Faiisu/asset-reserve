model AssetTemplate {
  id          String  @id @db.Uuid
  name        String  @unique @db.VarChar(150)
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  assets Asset[]

  @@map("asset_templates")
}

model Asset {
  id               String  @id @db.Uuid
  assetTemplateId  String? @map("asset_template_id") @db.Uuid
  managementAreaId String  @map("management_area_id") @db.Uuid
  name             String  @db.VarChar(150)
  description      String?
  pictureUrl       String? @map("picture_url")
  totalQuantity    Int     @default(0) @map("total_quantity")
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  assetTemplate     AssetTemplate?     @relation(fields: [assetTemplateId], references: [id])
  managementArea    ManagementArea     @relation(fields: [managementAreaId], references: [id])
  assetTransactions AssetTransaction[]
  reservationItems  ReservationItem[]

  // Database CHECK required by the source specification: total_quantity >= 0.
  @@unique([managementAreaId, name])
  @@map("assets")
}

model AssetTransactionBatch {
  id          String  @id @db.Uuid
  description String?
  performedBy String  @map("performed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  performer    User               @relation(fields: [performedBy], references: [id])
  transactions AssetTransaction[]

  @@map("asset_transaction_batches")
}

model AssetTransaction {
  id              String  @id @db.Uuid
  batchId         String  @map("batch_id") @db.Uuid
  assetId         String  @map("asset_id") @db.Uuid
  /// Supported values: ADD, REMOVE, LOST, BROKEN, REPAIR, RETURN, ADJUSTMENT.
  transactionType String  @map("transaction_type") @db.VarChar(30)
  /// Signed quantity change; its sign depends on transactionType.
  quantityDelta   Int     @map("quantity_delta")
  reason          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch AssetTransactionBatch @relation(fields: [batchId], references: [id])
  asset Asset                 @relation(fields: [assetId], references: [id])

  @@index([assetId, createdAt])
  @@index([batchId])
  @@map("asset_transactions")
}
